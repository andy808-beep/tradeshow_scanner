# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never put real secrets in this file.

# Public Supabase URL and key. Exposed to the browser via NEXT_PUBLIC_.
# Access to product prices and inquiries still requires a signed-in employee
# session; the browser must not query those tables directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy name. Used only when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# is unset. Prefer the publishable key when both exist.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Read exclusively by lib/supabase/admin.ts, which is marked
# "server-only" so importing it from a client component fails the build.
# This key bypasses Row Level Security: never expose it to the browser.
#
# On Vercel, set these in Project Settings → Environment Variables for
# Production (and Preview if you use it). A GitHub deploy does not copy
# .env.local. The Supabase Vercel integration often injects
# SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY; both names work.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
