# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never put real secrets in this file.

# Supabase project URL and publishable (anon) key.
# Both are exposed to the browser via the NEXT_PUBLIC_ prefix, which is expected:
# access control comes from Row Level Security policies, not from keeping these hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Read exclusively by lib/supabase/admin.ts, which is marked
# "server-only" so importing it from a client component fails the build.
# This key bypasses Row Level Security: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
