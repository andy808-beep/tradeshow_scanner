# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never put real secrets in this file.

# Supabase project URL and publishable (anon) key.
# Both are exposed to the browser via the NEXT_PUBLIC_ prefix, which is expected:
# access control comes from Row Level Security policies, not from keeping these hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets go below without the NEXT_PUBLIC_ prefix, e.g.:
# SUPABASE_SERVICE_ROLE_KEY=
